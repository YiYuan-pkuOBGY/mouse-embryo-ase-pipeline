# Copy to pipeline.env and edit on the Slurm server.
# The real pipeline.env is ignored by Git.

PROJECT_ROOT="/path/to/ASE_test"
ASE_ENV="/path/to/conda/envs/ase"
RNASEQ_ENV="/path/to/conda/envs/rnaseq2"

STAR_INDEX="/path/to/ASE_test/ref/star_index_M25"
SNP_FILE="/path/to/ASE_test/ref/snp/CAST_vs_BDF1.GRCm38.snps.chr.txt.gz"
GTF="/path/to/ref/mm10/gencode.vM25.annotation.gtf"

SLURM_PARTITION="batch"
LOG_DIR="${PROJECT_ROOT}/logs"
ALIGN_DIR="${PROJECT_ROOT}/align"
ALLELE_DIR="${PROJECT_ROOT}/allele_split"
COUNT_DIR="${PROJECT_ROOT}/gene_counts"

STAR_CPUS=16
STAR_MEM="50G"
STAR_TIME="12:00:00"

SNPSPLIT_CPUS=8
SNPSPLIT_MEM="64G"
SNPSPLIT_TIME="12:00:00"

COUNT_CPUS=8
COUNT_MEM="24G"
COUNT_TIME="06:00:00"

# 0=unstranded, 1=forward, 2=reverse
STRANDEDNESS=0
